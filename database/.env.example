# Copy to database/.env and replace every value before starting the stack.
# This file intentionally contains no usable credentials.
POSTGRES_PASSWORD=replace-with-a-local-admin-password
PEOPLEPAY360_RUNTIME_PASSWORD=replace-with-a-local-runtime-password
PEOPLEPAY360_MIGRATION_PASSWORD=replace-with-a-local-migration-password
PEOPLEPAY360_ANALYTICS_PASSWORD=replace-with-a-local-analytics-password
